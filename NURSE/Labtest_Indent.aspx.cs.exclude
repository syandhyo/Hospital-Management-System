        SqlDataAdapter da = new SqlDataAdapter("select A.slno AS ID ,A.INV AS INV from TEST_COMPONENT_TABLE A,TEST_CATEGORY_TABLE B,TEST_NAME_TABLE C WHERE A.ID=C.ID AND C.CATEGORY=B.ID AND B.ID='"+droptesttype.SelectedValue.ToString()+"' AND A.ORGID='" + lblorgid.Text + "'", con);
