        Medicine Name : </td>
    <td style="width:20%" align="left">
          <asp:TextBox ID="txtname" runat="server" CssClass="form-control input-sm m-bot15" AutoPostBack="True"></asp:TextBox>
         <asp:HiddenField ID="hfCustomerId" runat="server" />
         </td>
    <td style="width:20%" align="right">
        <asp:Label ID="lblpid4" runat="server" ForeColor="Red" style="color: #990033; font-weight: 700" Text="*"></asp:Label>
        Qty :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtopening" runat="server" Text="0" pattern="[0-9]+([,\.][0-9]+)?" MaxLength="10" CssClass="form-control input-sm m-bot15"  ></asp:TextBox>
         </td>
    <td style="width:20%; text-align: left;" align="center">
               <asp:ImageButton ID="ImageButton1" runat="server" BorderColor="Black" Height="32px" ImageUrl="~/PHARMACYSTORE/USER/img/Add.png" Width="43px" OnClick="ImageButton1_Click" />
