        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right"><asp:Label ID="Label2" runat="server" ForeColor="#CC0000" Text="*"></asp:Label>Mother ID :</td>
    <td style="width:20%" align="left">
        <asp:DropDownList ID="dropmotherid" runat="server" CssClass="btn btn-default dropdown-toggle" OnSelectedIndexChanged="dropmname_SelectedIndexChanged" AutoPostBack="true" style="width:150px">
        </asp:DropDownList>
         </td>
    <td style="width:20%" align="left"><asp:TextBox ID="TXTID" runat="server" CssClass="form-control input-sm m-bot15" Enabled="False" Visible="False"></asp:TextBox></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right">Mother Name :</td>
    <td style="width:20%" align="left"><asp:Label ID="lblmname" runat="server" Text="" Visible="true"> </asp:Label></td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right">Infant DOB :</td>
    <td style="width:20%" align="left"><asp:TextBox ID="txtdob" runat="server"   CssClass="formdate"  onkeydown="return false;" onpaste ="return false;"></asp:TextBox></td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right"><asp:Label ID="Label5" runat="server" ForeColor="#CC0000" Text="*"></asp:Label>Gender :</td>
    <td style="width:20%" align="left">
        <asp:DropDownList ID="dropgen" runat="server" CssClass="btn btn-default dropdown-toggle" style="width:150px">
             <asp:ListItem>Please Select</asp:ListItem>
            <asp:ListItem>Male</asp:ListItem>
            <asp:ListItem>Female</asp:ListItem>
        </asp:DropDownList>
    </td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right"><asp:Label ID="Label3" runat="server" ForeColor="#CC0000" Text="*"></asp:Label>Weight (in KG):</td>
    <td style="width:20%" align="left"><asp:TextBox ID="txtweight" runat="server" CssClass="form-control input-sm m-bot15" step="0.001" 
         pattern="^\d+(?:\.\d{1,3})?$" ToolTip="Enter numeric value">

                                       </asp:TextBox></td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
        <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="right"><asp:Label ID="Label4" runat="server" ForeColor="#CC0000" Text="*"></asp:Label>Father Name :</td>
    <td style="width:20%" align="left"><asp:TextBox ID="txtfname" runat="server" CssClass="form-control input-sm m-bot15" pattern="^[A-Za-z -]+$"></asp:TextBox></td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
                <table width="100%">
