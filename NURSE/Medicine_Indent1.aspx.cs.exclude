    protected void GridView2_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            var slno = GridView2.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlCommand com = new SqlCommand("select ID,PID,WARD,PNAME,BEDNO from MIND_TABLE where ID='" + slno + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                btncreate.Visible = false;
                btnupdate.Visible = true;
                TXTID.Text = dr["ID"].ToString();
                lblpid.Text = dr["PID"].ToString();
                lblpname.Text = dr["PNAME"].ToString();
                lblward.Text = dr["WARD"].ToString();
                lblbedno.Text = dr["BEDNO"].ToString();
            }
            dr.Close();
            da = new SqlDataAdapter("select NAME,QTY FROM MINDENT_TABLE where ID='" + TXTID.Text + "' and ORGID='" + lblorgid.Text + "'", con);
            DataSet ds2 = new DataSet();
            da.Fill(ds2);
            grvStudentDetails.DataSource = ds2.Tables["Table"];
            grvStudentDetails.DataBind();

            DataTable dt = ds2.Tables["Table"];
            ViewState["ITEM"] = dt;

            SqlDataAdapter da1 = new SqlDataAdapter("select NAME,QTY FROM MINDENT_TABLE where ID='" + TXTID.Text + "' and ORGID='" + lblorgid.Text + "'", con);
            DataSet ds3 = new DataSet();
            da1.Fill(ds3);
            GridView1.DataSource = ds3.Tables["Table"];
            GridView1.DataBind();
            btndelete.Visible = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
