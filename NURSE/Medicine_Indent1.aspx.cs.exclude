        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        MIND_TABLE_UPDATE();
        MINDENT_TRAN_UPDATE();
        Response.Redirect("~/NURSE/Medicine_Indent1.aspx");
        con.Close();
    }
    protected void Btndelete_Click(object sender, EventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlDataAdapter da = new SqlDataAdapter("delete from MINDENT_TABLE where ID='" + TXTID.Text + "'", con);
            DataSet d = new DataSet();
            da.Fill(d);
            SqlDataAdapter da1 = new SqlDataAdapter("delete from MIN_TABLE where ID='" + TXTID.Text + "'", con);
            DataSet d1 = new DataSet();
            da1.Fill(d1);
            SqlCommand cmd = new SqlCommand("Delete from MEDICINE_STATUS_TABLE where ID='" + TXTID.Text + "'", con);
            cmd.ExecuteNonQuery();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/NURSE/Medicine_Indent1.aspx");
    }
