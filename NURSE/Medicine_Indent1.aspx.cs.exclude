    protected void Button1_Click(object sender, EventArgs e)
    {
        try
        {
            if (lblpid.Text == "")
            {
                string message = "alert('* Fields are mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            else if (grvStudentDetails.Rows.Count <= 0)
            {
                string message = "alert('* Add item to Cart.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            auto();
            MIND_TABLE();
            MINDENT_TABLE();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/NURSE/Medicine_Indent1.aspx");
    }
    public void MIND_TABLE()
    {
        //try
        //{
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        SqlCommand stock_cmd = new SqlCommand("insert into MIND_TABLE (FYEAR,ORGID,ID,DATE,PID,WARD,PNAME,TYPE,BEDNO,UNAME,UID,STATUS) values (@FYEAR,@ORGID,@ID,@DATE,@PID,@WARD,@PNAME,@TYPE,@BEDNO,@UNAME,@UID,@STATUS)", con);
        stock_cmd.Parameters.Add("@FYEAR", SqlDbType.VarChar).Value = lblfyear.Text;
        stock_cmd.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
        stock_cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
        stock_cmd.Parameters.Add("@DATE", SqlDbType.DateTime).Value = txtinvdate.Text;
        stock_cmd.Parameters.Add("@PID", SqlDbType.VarChar).Value = lblpid.Text;
        stock_cmd.Parameters.Add("@WARD", SqlDbType.VarChar).Value = lblward.Text;
        stock_cmd.Parameters.Add("@PNAME", SqlDbType.VarChar).Value = lblpname.Text;
        stock_cmd.Parameters.Add("@TYPE", SqlDbType.VarChar).Value = lblindetype.Text;
        stock_cmd.Parameters.Add("@BEDNO", SqlDbType.VarChar).Value = lblbedno.Text;
        stock_cmd.Parameters.Add("@UNAME", SqlDbType.VarChar).Value = lblid.Text;
        stock_cmd.Parameters.Add("@UID", SqlDbType.VarChar).Value = lbluid.Text;
        stock_cmd.Parameters.Add("@STATUS", SqlDbType.VarChar).Value = "Waiting";
        stock_cmd.ExecuteNonQuery();
        SqlCommand cmd = new SqlCommand("insert into MEDICINE_STATUS_TABLE (ORGID,ID,STATUS,TYPE,DATE,WARD,BEDNO,PID) values (@ORGID,@ID,@STATUS,@TYPE,@DATE,@WARD,@BEDNO,@PID)", con);
        cmd.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
        cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
        cmd.Parameters.Add("@STATUS", SqlDbType.VarChar).Value = "Waiting";
        cmd.Parameters.Add("@TYPE", SqlDbType.VarChar).Value = lblindetype.Text;
        cmd.Parameters.Add("@DATE", SqlDbType.DateTime).Value = txtinvdate.Text;
        cmd.Parameters.Add("@WARD", SqlDbType.VarChar).Value = lblward.Text;
        cmd.Parameters.Add("@BEDNO", SqlDbType.VarChar).Value = lblbedno.Text;
        cmd.Parameters.Add("@PID", SqlDbType.VarChar).Value = lblpid.Text;
        cmd.ExecuteNonQuery();
        con.Close();
        //}
        //catch { }
    }
    public void MINDENT_TABLE()
    {
        //try
        //{
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        DataTable dt1 = ViewState["ITEM"] as DataTable;
        GridView1.DataSource = dt1;
        GridView1.DataBind();

        foreach (GridViewRow gv1 in GridView1.Rows)
        {
            SqlCommand cmd2 = new SqlCommand("insert into MINDENT_TABLE (ORGID,ID,NAME,QTY) values (@ORGID,@ID,@NAME,@QTY)", con);
            cmd2.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
            cmd2.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
            cmd2.Parameters.Add("@NAME", SqlDbType.VarChar).Value = gv1.Cells[0].Text;
            cmd2.Parameters.Add("@QTY", SqlDbType.VarChar).Value = gv1.Cells[1].Text;
            cmd2.ExecuteNonQuery();
        }
        //}
        //catch { }

    }
    public void MIND_TABLE_UPDATE()
    {
        //try
        //{
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        SqlCommand stock_cmd = new SqlCommand("UPDATE MIND_TABLE SET PID=@PID,WARD=@WARD,PNAME=@PNAME,BEDNO=@BEDNO WHERE ID=@ID)", con);
        stock_cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
        stock_cmd.Parameters.Add("@PID", SqlDbType.VarChar).Value = lblpid.Text;
        stock_cmd.Parameters.Add("@WARD", SqlDbType.VarChar).Value = lblward.Text;
        stock_cmd.Parameters.Add("@PNAME", SqlDbType.VarChar).Value = lblpname.Text;
        stock_cmd.Parameters.Add("@BEDNO", SqlDbType.VarChar).Value = lblbedno.Text;
        stock_cmd.ExecuteNonQuery();

        SqlCommand cmd = new SqlCommand("UPDATE MEDICINE_STATUS_TABLE SET WARD=@WARD,BEDNO=@BEDNO,PID=@PID WHERE ID=@ID", con);
        cmd.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
        cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
        cmd.Parameters.Add("@STATUS", SqlDbType.VarChar).Value = "Waiting";
        cmd.Parameters.Add("@TYPE", SqlDbType.VarChar).Value = lblindetype.Text;
        cmd.Parameters.Add("@DATE", SqlDbType.DateTime).Value = txtinvdate.Text;
        cmd.Parameters.Add("@WARD", SqlDbType.VarChar).Value = lblward.Text;
        cmd.Parameters.Add("@BEDNO", SqlDbType.VarChar).Value = lblbedno.Text;
        cmd.Parameters.Add("@PID", SqlDbType.VarChar).Value = lblpid.Text;
        cmd.ExecuteNonQuery();
        con.Close();

        //}
        //catch { }
    }
    public void MINDENT_TRAN_UPDATE()
    {
        //try
        //{
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
