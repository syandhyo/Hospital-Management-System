        cr.rodc.Clone();
        cr.rodc.Dispose();
        rodc = null;
        System.GC.Collect();
        System.GC.WaitForPendingFinalizers();
        //}
    }
    protected void dropbedno_SelectedIndexChanged(object sender, EventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlCommand COM = new SqlCommand("SELECT A.VN,A.PNAME,A.BEDNO,B.AGE,B.GENDER FROM BED_TABLE A,ADMISSION_TABLE B WHERE  A.BEDNO='" + dropbedno.Text + "' AND A.VN=B.VN", con);
            dr1 = COM.ExecuteReader();
            if (dr1.Read())
            {
                lblipno.Text = dr1["VN"].ToString();
                lblname.Text = dr1["PNAME"].ToString();
                lblbedno.Text = dr1["BEDNO"].ToString();
                lblage.Text = dr1["AGE"].ToString();
                lblgender.Text = dr1["GENDER"].ToString();
            }
            dr1.Close();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }

    }
    protected void Button3_Click(object sender, EventArgs e)
    {
       
        Session["MY"] = "TRUE";
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            if (dropbedno.SelectedIndex == 0)
            {
                string message = "alert('Please Select BED. Number')";
