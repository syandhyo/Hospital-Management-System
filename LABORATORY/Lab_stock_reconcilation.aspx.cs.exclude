    protected void GridView1_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            var slno = GridView1.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            using (SqlCommand cmd = new SqlCommand("LAB_STOCK_RECONCILIATION", con))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_1EVENT";
                cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = slno;
                cmd.Parameters.Add("@DEPTID", SqlDbType.VarChar).Value = "";
                cmd.Parameters.Add("@ITEMNAME", SqlDbType.VarChar).Value = "NULL";
                //SqlDataAdapter da = new SqlDataAdapter(com);
                //SqlCommand com = new SqlCommand("select * from TBL_STOCKRECONLAB where ID='" + slno + "'", con);
                dr = cmd.ExecuteReader();
                if (dr.Read())
                {
                    btnsubmit.Visible = false;
                    btnupdate.Visible = true;
                    btndelete.Visible = true;
                    btncancel.Visible = true;
                    btncancel1.Visible = false;
                    TXTID.Text = dr["ID"].ToString();
                    lbldate.Text = dr["DATE"].ToString();
                    Ddlitem.SelectedItem.Text = dr["ITEM"].ToString();
                    //Session["i_id"] = dr["ITEM"].ToString();
                    txt_des.Text = dr["DESCRIPTN"].ToString();
                    txtquant.Text = dr["QUANTITY"].ToString();

                }
            }
            dr.Close();
            using (SqlCommand cmd4 = new SqlCommand("LAB_RECON_NEW", con))
            {
                cmd4.CommandType = CommandType.StoredProcedure;
                cmd4.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "EDIT";
                cmd4.Parameters.Add("@ID", SqlDbType.VarChar).Value = slno;
                cmd4.Parameters.Add("@STOCK", SqlDbType.Decimal).Value = Convert.ToDecimal(txtquant.Text).ToString();
                cmd4.Parameters.Add("@ITEMNAME", SqlDbType.VarChar).Value = Ddlitem.SelectedItem.Text;
                cmd4.ExecuteNonQuery();
            }
            con.Close();

            con.Open();
            using (SqlCommand cmd1 = new SqlCommand("LAB_STOCK_RECONCILIATION", con))
            {
                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_2DEPT_DROP";
                cmd1.Parameters.Add("@ID", SqlDbType.VarChar).Value = "";
                cmd1.Parameters.Add("@DEPTID", SqlDbType.VarChar).Value = "";
                cmd1.Parameters.Add("@ITEMNAME", SqlDbType.VarChar).Value = "NULL";
                SqlDataAdapter da = new SqlDataAdapter(cmd1);
                //SqlDataAdapter da = new SqlDataAdapter("  select * from tblDepartment where DeptName='Pathology'", con);
                DataTable ds = new DataTable();
                da.Fill(ds);
                Ddldept.DataSource = ds;
                Ddldept.DataTextField = "DeptName";
                Ddldept.DataValueField = "id";
                Ddldept.DataBind();
            }
            con.Close();

            con.Open();
            using (SqlCommand cmd2 = new SqlCommand("LAB_STOCK_RECONCILIATION", con))
            {
                cmd2.CommandType = CommandType.StoredProcedure;
                cmd2.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_ITEMNAME";
                cmd2.Parameters.Add("@ID", SqlDbType.VarChar).Value = slno;
                cmd2.Parameters.Add("@DEPTID", SqlDbType.VarChar).Value = Ddldept.SelectedValue;
                cmd2.Parameters.Add("@ITEMNAME", SqlDbType.VarChar).Value = Ddlitem.SelectedItem.Text;
                //SqlDataAdapter da = new SqlDataAdapter(cmd2);
                //cmd = con.CreateCommand();
                //cmd.CommandText = "  select * from TBL_DEPT_MAT_STOCK where ITEMNAME='" + Ddlitem.SelectedItem.Text + "'";
                dr = cmd2.ExecuteReader(CommandBehavior.CloseConnection);
                if (dr.Read() == true)
                {
                    lblquant.Text = dr["STOCK"].ToString();
                    dr.Close();
                    con.Close();

                }
            }
            using (SqlCommand cmd3 = new SqlCommand("LAB_STOCK_RECONCILIATION", con))
            {
                cmd3.CommandType = CommandType.StoredProcedure;
                cmd3.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_3EVENT";
                cmd3.Parameters.Add("@ID", SqlDbType.VarChar).Value = Ddldept.SelectedValue;
                cmd3.Parameters.Add("@DEPTID", SqlDbType.VarChar).Value = Ddldept.SelectedValue;
                cmd3.Parameters.Add("@ITEMNAME", SqlDbType.VarChar).Value = Ddlitem.SelectedItem.Text;
                SqlDataAdapter da1 = new SqlDataAdapter(cmd3);
                //SqlDataAdapter da1 = new SqlDataAdapter("Select SLNO as id,ITEMNAME from TBL_DEPT_MAT_STOCK where ID='" + Ddldept.SelectedValue + "' and ITEMNAME='" + Ddlitem.SelectedItem.Text + "' ", con);
                DataTable ds1 = new DataTable();
                da1.Fill(ds1);
                Ddlitem.DataSource = ds1;
                Ddlitem.DataTextField = "ITEMNAME";
                Ddlitem.DataValueField = "id";
                Ddlitem.DataBind();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }

    }
