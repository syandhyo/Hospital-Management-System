    protected void btnview_Click(object sender, EventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();

            if (txtlabno.Text == "")
            {
                string message = "alert('* Please Enter Bill No.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);

                return;
            }
            SqlCommand com = new SqlCommand("select a.ID,a.OPDNO,a.NAME,a.CORPORATE,a.EMPID,b.INV,b.INVID,b.PRICE,c.NAME as NAME,c.REF as RANGE,c.UNIT from TBLRECLAB a,TBLRECLABITEM b,TEST_COMPONENT_TABLE c where a.ID=b.ID and c.slno=b.INVID  and  a.ID='" + txtlabno.Text + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                txtopdNO.Text = dr["OPDNO"].ToString();
                txtname.Text = dr["NAME"].ToString();
                txtcorprate.Text = dr["CORPORATE"].ToString();
                txtempid.Text = dr["EMPID"].ToString();
                //droptesttype.Text = dr["SELECTYPE"].ToString();
            }
            dr.Close();
            DataSet dtt = new DataSet();
            SqlDataAdapter daa = new SqlDataAdapter(com);
            daa.Fill(dtt);
            GridView1.DataSource = dtt;
            GridView1.DataKeyNames = new string[] { "ID" };
            GridView1.DataBind();


            divgrid.Visible = true;
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }

    }
  
    protected void btncreate_Click(object sender, EventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            //  if (txtlabno.Text == "")
            //{
            //    string message = "alert('* Please Enter Bill No.')";
            //    ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);

            //    return;
            //}
            auto();
            datatable_po_item();
            SqlCommand cmd = new SqlCommand("insert into LABRES_TABLE (ID,LINDID,PID,PNAME)VALUES(@ID,@LINDID,@PID,@PNAME)", con);
            cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text;
            cmd.Parameters.Add("@LINDID", SqlDbType.VarChar).Value = txtlabno.Text;
            cmd.Parameters.Add("@PID", SqlDbType.VarChar).Value = txtopdNO.Text;
            cmd.Parameters.Add("@PNAME", SqlDbType.VarChar).Value = txtname.Text;


            cmd.ExecuteNonQuery();
            // Session["LABID"] = TXTID.Text;
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/LABORATORY/ViewBillEntry.aspx");
    }
    public void datatable_po_item()
    {
        //try
        //{
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();

        foreach (GridViewRow row in GridView1.Rows)
        {
            var name = row.FindControl("lblname") as Label;
            var inv = row.FindControl("lblinv") as Label;
            var price = row.FindControl("lblprice") as TextBox;
            var renge = row.FindControl("txtref") as TextBox;
            var unit = row.FindControl("txtunit") as TextBox;
            var value = row.FindControl("txt_value") as TextBox;
            

           // amount = amount + Convert.ToDecimal(AMT.Text);
           // var INV = Convert.ToInt32(GridView1.DataKeys[row.RowIndex].Values[0]);
            SqlCommand stock_cmd = new SqlCommand("INSERT INTO LABRESULT_TABLE (ID,LINDID,INV,VALUE,REF,UNIT,PRICE) VALUES (@ID,@LINDID,@INV,@VALUE,@REF,@UNIT,@PRICE)", con);
            stock_cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = TXTID.Text; 
            stock_cmd.Parameters.Add("@LINDID", SqlDbType.VarChar).Value = txtlabno.Text;
            stock_cmd.Parameters.Add("@INV", SqlDbType.VarChar).Value = inv.Text.ToString();
            stock_cmd.Parameters.Add("@PRICE", SqlDbType.VarChar).Value = price.Text.ToString();
            stock_cmd.Parameters.Add("@REF", SqlDbType.VarChar).Value = renge.Text.ToString();
            stock_cmd.Parameters.Add("@VALUE", SqlDbType.VarChar).Value = value.Text.ToString();
           
            stock_cmd.Parameters.Add("@UNIT", SqlDbType.VarChar).Value = unit.Text.ToString();
          
            stock_cmd.ExecuteNonQuery();

        }
        //}
        //catch (Exception ex)
        //{

        //}
        con.Close();
    }
