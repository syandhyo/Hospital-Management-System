<%@ Page Title="" Language="C#" MasterPageFile="~/LABORATORY/MasterPage1.master" AutoEventWireup="true" CodeFile="PatientSearch.aspx.cs" Inherits="LABORATORY_PatientSearch" %>
   

<asp:Content ID="Content1" ContentPlaceHolderID="head" Runat="Server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" Runat="Server">
    <asp:Label ID="lblid" runat="server" Text="Label"></asp:Label>(<asp:Label ID="lblfyear" runat="server" Text="Label"></asp:Label>)
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="ContentPlaceHolder1" Runat="Server">
    <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
 <asp:UpdatePanel ID="UpdatePanel1" runat="server">
          <ContentTemplate>
    
     <asp:Label ID="lblorgid" runat="server" Text="Label" Visible="false"> </asp:Label>
            <asp:Label ID="lbluid" runat="server" Text="Label" Visible="false"> </asp:Label>
   <div style="border: 1px solid #0b2c4a;height: 480px;width:100%;margin-left:5px;background-color:#d2e7f9;">
        <h3 style="font-weight:bold;color:#009688;font-family:helvetica;text-align:center;">PATIENT SEARCH</h3>
        <div class="col-md-6">
          <div style="border: 1px solid #0b2c4a;height: 140px;width:100%;">
            <div style="font-size:25px;color:#0e5571;font-family:serif;text-align:center;font-weight:510;">OPD Search</div>
            <br />
            <div class="form-group">
               <label for="inputEmail1" class="col-md-5 control-label"> <spam style="color:red;font-size:15px;font-weight:bold;margin-left:46px;">*</spam> <spam style="font-size:16px;font-weight:bold;color:#0b2c4a;float:right;">Search By OPD No. :</spam></label>
                <div class="col-md-7">
                 
                    <asp:TextBox ID="txtspid" runat="server" BackColor="#ffffff" Height="25" Width="200" style="border-radius:6px;float:left;" pattern="[a-zA-Z0-9\s]*$" MaxLength="6" minlength="6" Title="Please enter a valid OPD No.." autocomplete="off"></asp:TextBox>
         &nbsp;<asp:Button ID="btnshow" runat="server" BackColor="#265c77" Text="Show" Width="60px" Height="26" OnClick="btnshow_Click" Style="margin-left:15px;color:white;font-weight:bold;font-size:15px;border-radius:6px;" />  
                </div>
            </div>

            <br /><br />

            <div class="form-group">
               <label for="inputEmail1" class="col-md-5 control-label"> <spam style="color:red;font-size:15px;font-weight:bold;margin-left:35px;">*</spam> <spam style="font-size:16px;font-weight:bold;color:#0b2c4a;float:right;">Search By Phone No.  :</spam></label>
                <div class="col-md-7">
                 
                     <asp:TextBox ID="txtsmobile" runat="server" BackColor="#ffffff" Height="25" Width="200" style="border-radius:6px;" pattern="[789][0-9]{9}" title="Please Enter Valid Number EX;9876543215" MaxLength="10" minlength="10" autocomplete="off"></asp:TextBox>
         &nbsp;<asp:Button ID="btnshowph" runat="server" BackColor="#265c77" Text="Show" Width="60px" Height="26" OnClick="btnshowph_Click" Style="margin-left:15px;color:white;font-weight:bold;font-size:15px;border-radius:6px;" />
                    
                     </div>
            </div>
            <br />
            
          </div>
        </div>

        <div class="col-md-6">

          <div style="border: 1px solid #0b2c4a;height: 140px;width:100%;">
             <div style="font-size:25px;color:#0e5571;font-family:serif;text-align:center;font-weight:510;">IPD Search</div>
            <br />
            <div class="form-group">
               <label for="inputEmail1" class="col-md-5 control-label"> <spam style="color:red;font-size:15px;font-weight:bold;margin-left:53px;">*</spam> <spam style="font-size:16px;font-weight:bold;color:#0b2c4a;float:right;">Search By IPD No. :</spam></label>
                <div class="col-md-7">
                
                    <asp:TextBox ID="txtip" runat="server" BackColor="#ffffff" Height="25" Width="200" style="border-radius:6px;float:left;" pattern="^[a-zA-Z0-9]*$" MaxLength="6" minlength="6" Title="Please enter a valid OPD No.." autocomplete="off"></asp:TextBox>
         &nbsp;<asp:Button ID="btnshowip" runat="server" BackColor="#265c77" Text="Show" Width="60px" Height="26" OnClick="btnshowip_Click" Style="margin-left:15px;color:white;font-weight:bold;font-size:15px;border-radius:6px;"/>
                     </div>
            </div>
            <br /><br />
            <div class="form-group">
               <label for="inputEmail1" class="col-md-5 control-label"> <spam style="color:red;font-size:15px;font-weight:bold;margin-left:52px;">*</spam> <spam style="font-size:16px;font-weight:bold;color:#0b2c4a;float:right;">Search By Bed No.  :</spam></label>
                <div class="col-md-7">
                                 &nbsp;<asp:DropDownList ID="DropDownList1" runat="server" BackColor="#ffffff" Height="25" Width="200" style="border-radius:6px;" >
                </asp:DropDownList>
                <asp:Button ID="btnshowbed" runat="server" BackColor="#265c77" Text="Show" Width="60px" Height="26" OnClick="btnshowbed_Click" Style="margin-left:15px;color:white;font-weight:bold;font-size:15px;border-radius:6px;" />
                     </div>
            </div>
            <br /><br />
            
        </div>
        </div>

       <div class="col-lg-12">
           <div class="col-lg-6">
                <table width="100%">
                <tr>
                   
                          <asp:GridView ID="GridView1" runat="server" AutoGenerateColumns="False" DataKeyNames="ID"  AllowPaging="True" AllowSorting="True"  CssClass="table table-bordered" style="color:black;background-color:#009997;font-weight:bold;width:100px;margin-left:60px;">
                            <Columns>
                                 <asp:BoundField DataField="ID" HeaderText="OPNO" HeaderStyle-CssClass="text-center"/>
                                <asp:BoundField DataField="PNAME" HeaderText="NAME" HeaderStyle-CssClass="text-center"/>
                                <asp:BoundField DataField="TELPHNO" HeaderText="PHONE" HeaderStyle-CssClass="text-center"/>                
                                <asp:BoundField DataField="MOBNO" HeaderText="ECONTACT" HeaderStyle-CssClass="text-center"/>
                                <%--<asp:BoundField DataField="DISEASE" HeaderText="DISEASE" />--%>
                                <asp:BoundField DataField="DATETIME" HeaderText="DATE" DataFormatString="{0:dd/MM/yyyy}" HeaderStyle-CssClass="text-center"/>
                            </Columns>
                        </asp:GridView>
                      </td>
                    <td style="width:20%" align="center"></td>
                </tr>
            </table>
           </div>
            <div class="col-lg-6">
                <br />
                 <table width="100%" style="margin-left:70px;">
                 <tr>
                   
                    <td>
                          <asp:GridView ID="GridView2" runat="server" AutoGenerateColumns="False"   AllowPaging="True" AllowSorting="True"  CssClass="table table-bordered" style="color:black;background-color:#009997;font-weight:bold;">
                            <Columns>                               
                                  <asp:BoundField DataField="VN" HeaderText="IPDNO" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center" />
                                <asp:BoundField DataField="BEDNO" HeaderText="BEDNO" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                              <asp:BoundField DataField="PNAME" HeaderText="NAME" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                                <asp:BoundField DataField="PHONE" HeaderText="PHONE" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                                <asp:BoundField DataField="ECONTACT" HeaderText="ECONTACT" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                                <asp:BoundField DataField="DISEASE" HeaderText="DISEASE" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                                <asp:BoundField DataField="DATE" HeaderText="ADMISSION DATE" HeaderStyle-CssClass="text-center" ItemStyle-HorizontalAlign="Center"/>
                                <%--<asp:CommandField ShowDeleteButton="False" ShowEditButton="False" ShowSelectButton="False" />--%>
                            </Columns>
                        </asp:GridView>
                    </td>
                <td style="width:20%" align="center"></td>
            </tr>
        </table>
           </div>
       </div>
    </div>



              </ContentTemplate></asp:UpdatePanel>
</asp:Content>

