            <Columns>     
               <asp:BoundField DataField="OPNo" HeaderText="OPD No."  HeaderStyle-CssClass="text-center"  />
                  <asp:BoundField DataField="Name" HeaderText="Patient&nbsp;Name" HeaderStyle-CssClass="text-center"/>
