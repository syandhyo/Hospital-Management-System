        $(function () {
            $('.formdate').datepicker({
                dateFormat: 'dd-mm-yy',
                changeMonth: true,
                changeYear: true,
                minDate: '-75Y',
                yearRange: "c-75:c+10",

            });
            $('.todate').datepicker({
                dateFormat: 'dd-mm-yy',
                changeMonth: true,
                changeYear: true,
                minDate: '-75Y',
                yearRange: "c-75:c+10",
            });
        });
        
    </script>
    <script type="text/javascript">
        function Validate() {
            if (document.getElementById('<%=dropDept.ClientID%>').selectedIndex == 0) {
                   alert("Department Name is Required !");
                   document.getElementById('<%=dropDept.ClientID%>').focus();
                   return false;
               }
         }
    </script>
     <script type="text/javascript">
         function Validate1() {            
