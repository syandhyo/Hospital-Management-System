        Admission fee :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtregfee" runat="server" CssClass="" MaxLength="5"  pattern="[0-9]+([,\.][0-9]+)?" Value="0" onclick="if(this.value=='0'){this.value=''}" onblur="if(this.value==''){this.value='0'}"
></asp:TextBox>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
