    protected void droppayment_SelectedIndexChanged(object sender, EventArgs e)
    {
        try
        {
            if (droppayment.SelectedIndex == 0)
            {
                txtcard.Visible = false;
                txtcard.Text = "";
            }
            else
            {
                txtcard.Visible = true;
                txtcard.Text = "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    
