           // dropinsurance.Items.Insert(0, "No Corporate");
            dropinsurance.Items.Insert(0, "--SELECT--");
        }


        //SqlDataAdapter da4 = new SqlDataAdapter("SELECT ID,COMNYNAME FROM INSURANCE_TBL WHERE ISACTIVE='True'", con);
        //DataTable dt4 = new DataTable();
        //da4.Fill(dt4);
