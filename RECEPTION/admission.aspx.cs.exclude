    public void clear_control()
    {
       // txtdate.Text = DateTime.Now.ToString("dd-MM-yyyy HH:mm");
        txtdate.Text = "";
        lblpid.Text = "";
        txtname.Text = "";
        txtphone.Text = "0";
        txtecontact.Text = "0";
        txtage.Text = "0";
        txtdate.Text = "0";
        Txtperad.Text = "0";
        //txtpref.Text = "0";
        txtregfee.Text = "0";
        txttempad.Text = "0";
       // txtdiease.Text = "0";
