    protected void grvdoctor_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        var slno = grvdoctor.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        using (SqlCommand cmd = new SqlCommand("ADMIN_DISC_EMPLOYEE", con))
        {
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_EVENT";
            cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = slno;
            cmd.Parameters.Add("@CARDNAME", SqlDbType.VarChar).Value = txtcardname.Text;
            cmd.Parameters.Add("@ROOMRENT", SqlDbType.VarChar).Value = txtroomcharge.Text;
            cmd.Parameters.Add("@PHARMACY", SqlDbType.VarChar).Value = txtdiscpharmacy.Text;
            cmd.Parameters.Add("@LAB", SqlDbType.VarChar).Value = txtdisclab.Text;
            cmd.Parameters.Add("@RADIOLOGY", SqlDbType.VarChar).Value = txtdiscradilogy.Text;
            cmd.Parameters.Add("@OT", SqlDbType.VarChar).Value = txtdiscot.Text;
            //SqlCommand com = new SqlCommand("select * from STAFF_DISC_MASTER where ID='" + slno + "'", con);
            dr = cmd.ExecuteReader();
            if (dr.Read())
            {
                btncreate.Visible = false;
                btnupdate.Visible = true;
                txtid.Text = slno.ToString();
                txtcardname.Text = dr["CARDNAME"].ToString();
                txtroomcharge.Text = dr["ROOMRENT"].ToString();
                txtdiscpharmacy.Text = dr["PHARMACY"].ToString();
                txtdisclab.Text = dr["LAB"].ToString();
                txtdiscradilogy.Text = dr["RADIOLOGY"].ToString();
                txtdiscot.Text = dr["OT"].ToString();
            }
            dr.Close();
        }
        con.Close();
    }
    protected void grvdoctor_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        if (e.Row.RowType == DataControlRowType.DataRow)
        {
            // reference the Delete LinkButton
            LinkButton db = (LinkButton)e.Row.Cells[7].Controls[0];

            db.OnClientClick = "return confirm('Are you sure want to delete this item ?');";
        }
    }
    protected void grvdoctor_RowDeleting(object sender, GridViewDeleteEventArgs e)
    {
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();

        string slno = grvdoctor.DataKeys[e.RowIndex].Values["ID"].ToString();
        using (SqlCommand cmd = new SqlCommand("ADMIN_DISC_EMPLOYEE", con))
        {
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "DELETE";
            cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = slno;
            cmd.Parameters.Add("@CARDNAME", SqlDbType.VarChar).Value = txtcardname.Text;
            cmd.Parameters.Add("@ROOMRENT", SqlDbType.VarChar).Value = txtroomcharge.Text;
            cmd.Parameters.Add("@PHARMACY", SqlDbType.VarChar).Value = txtdiscpharmacy.Text;
            cmd.Parameters.Add("@LAB", SqlDbType.VarChar).Value = txtdisclab.Text;
            cmd.Parameters.Add("@RADIOLOGY", SqlDbType.VarChar).Value = txtdiscradilogy.Text;
            cmd.Parameters.Add("@OT", SqlDbType.VarChar).Value = txtdiscot.Text;
            //SqlCommand cm = new SqlCommand("delete from STAFF_DISC_MASTER where ID='" + slno + "'", con);
            cmd.ExecuteNonQuery();
        }
        binddata();
        con.Close();
    }
    protected void grvdoctor_PageIndexChanging(object sender, GridViewPageEventArgs e)
    {
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        using (SqlCommand cmd = new SqlCommand("ADMIN_DISC_EMPLOYEE", con))
        {
            cmd.CommandType = CommandType.StoredProcedure;
            cmd.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT_GRID_PAGE";
            cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = "";
            cmd.Parameters.Add("@CARDNAME", SqlDbType.VarChar).Value = txtcardname.Text;
            cmd.Parameters.Add("@ROOMRENT", SqlDbType.VarChar).Value = txtroomcharge.Text;
            cmd.Parameters.Add("@PHARMACY", SqlDbType.VarChar).Value = txtdiscpharmacy.Text;
            cmd.Parameters.Add("@LAB", SqlDbType.VarChar).Value = txtdisclab.Text;
            cmd.Parameters.Add("@RADIOLOGY", SqlDbType.VarChar).Value = txtdiscradilogy.Text;
            cmd.Parameters.Add("@OT", SqlDbType.VarChar).Value = txtdiscot.Text;
            SqlDataAdapter Adp = new SqlDataAdapter(cmd);
            //SqlDataAdapter Adp = new SqlDataAdapter("select ID,CARDNAME,ROOMRENT,PHARMACY,LAB,RADIOLOGY,OT from STAFF_DISC_MASTER", con);
            DataTable dt = new DataTable();
            Adp.Fill(dt);
            grvdoctor.DataSource = dt;
            grvdoctor.PageIndex = e.NewPageIndex;
            grvdoctor.DataKeyNames = new string[] { "id" };
            grvdoctor.DataBind();
        }
        con.Close();
    }
}