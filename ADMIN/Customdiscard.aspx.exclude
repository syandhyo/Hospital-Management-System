           <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label3" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Card Name :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtcname" runat="server" ></asp:TextBox>
         </td>
    <td style="width:20%" align="right">Date :</td>
    <td style="width:20%" align="left">
         <asp:TextBox ID="txtdate" runat="server" CssClass="formdate" onkeydown="return false;" onpaste ="return false;"></asp:TextBox>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table> 
           <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label2" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Card Fee :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtcardfee" runat="server" value="0.00" pattern="[0-9]+([,\.][0-9]+)?"
              onclick="if(this.value=='0.00'){this.value=''}" onblur="if(this.value==''){this.value='0.00'}"></asp:TextBox>
      
         </td>
    <td style="width:20%" align="right">Valid :</td>
    <td style="width:30%" align="left">
         <asp:TextBox ID="txtvalid" runat="server" ></asp:TextBox>Days
         </td>
    <td style="width:10%" align="center"></td>
</tr>
</table> 
           <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label4" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Active :</td>
