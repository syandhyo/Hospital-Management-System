            //    string message = "alert('*City Fields are mandatory.')";
            //    ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
            //    return;
            //}
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();

            using (SqlCommand cmd1 = new SqlCommand("USP_OUTSIDELAB_ADMN", con))
            {
                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "INSERT";
                cmd1.Parameters.Add("@ID", SqlDbType.Int).Value = 1;
                cmd1.Parameters.Add("@NAME", SqlDbType.VarChar).Value = txtname.Text;
                cmd1.Parameters.Add("@ADRESSS", SqlDbType.VarChar).Value = txtadress.Text;
                cmd1.Parameters.Add("@PHONENO", SqlDbType.VarChar).Value = txtphoneno.Text;
                cmd1.Parameters.Add("@CITY", SqlDbType.VarChar).Value = txtcity.Text;
                cmd1.Parameters.Add("@STATE", SqlDbType.VarChar).Value = txtstate.Text;
                cmd1.Parameters.Add("@FYEAR", SqlDbType.VarChar).Value = lblfyear.Text;
                cmd1.ExecuteNonQuery();
            }

            //SqlCommand cmd1 = new SqlCommand("insert into TBL_OUTSIDELAB (NAME ,ADRESSS ,PHONENO ,CITY ,STATE ,FYEAR)  values (@NAME ,@ADRESSS ,@PHONENO ,@CITY ,@STATE ,@FYEAR)", con);
            //cmd1.Parameters.Add("@NAME", SqlDbType.VarChar).Value = txtname.Text;
            //cmd1.Parameters.Add("@ADRESSS", SqlDbType.VarChar).Value = txtadress.Text;
            //cmd1.Parameters.Add("@PHONENO", SqlDbType.VarChar).Value = txtphoneno.Text;
            //cmd1.Parameters.Add("@CITY", SqlDbType.VarChar).Value = txtcity.Text;
            //cmd1.Parameters.Add("@STATE", SqlDbType.VarChar).Value = txtstate.Text;
            //cmd1.Parameters.Add("@FYEAR", SqlDbType.VarChar).Value = lblfyear.Text;

            //cmd1.ExecuteNonQuery();
            string message1 = "alert('Created Successfully.')";
            ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message1, true);

            resetCt();
            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    public void resetCt()
    {
      txtname.Text= "";
      txtadress.Text = "";
      txtphoneno.Text = "";
      txtcity.Text = "";
      txtstate.Text = "";
    }
