    <td style="width:20%; text-align: left;" align="right">
        <asp:DropDownList ID="drptype" runat="server" CssClass="form-control input-sm m-bot15" style="width:150px" AutoPostBack="true"  OnSelectedIndexChanged="drptype_SelectedIndexChanged">
