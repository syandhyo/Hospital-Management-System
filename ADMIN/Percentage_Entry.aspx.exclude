        Select Recipient :</td>
    <td style="width:20%; text-align: left;" align="right">
        <asp:DropDownList ID="droprecipient" runat="server" CssClass="form-control input-sm m-bot15" style="width:150px"></asp:DropDownList>&nbsp;</td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
