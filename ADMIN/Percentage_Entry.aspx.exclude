        <asp:Label ID="Label4" runat="server" ForeColor="Red" Text="*"></asp:Label>
        % In Lab :&nbsp;</td>
    <td style="width:20%; text-align: left;" align="right"> 
          <asp:TextBox ID="txtdisclab" runat="server" CssClass="form-control input-sm m-bot15"  pattern="[0-9]+([,\.][0-9]+)?" value="0.00" 
            onclick="if(this.value=='0.00'){this.value=''}" onblur="if(this.value==''){this.value='0.00'}" ></asp:TextBox>
         </td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table><table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%; text-align: right;" align="left">
        <asp:Label ID="Label5" runat="server" ForeColor="Red" Text="*"></asp:Label>
        % In Room Charge :</td>
    <td style="width:20%; text-align: left;" align="right"> <asp:TextBox ID="txtroomcharge" runat="server"   
        pattern="[0-9]+([,\.][0-9]+)?" MaxLength="2" CssClass="form-control input-sm m-bot15"
        value="0.00" 
            onclick="if(this.value=='0.00'){this.value=''}" onblur="if(this.value==''){this.value='0.00'}"></asp:TextBox>
         </td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
    <table width="100%">
