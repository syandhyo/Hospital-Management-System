        % In Radiology Charge :</td>
    <td style="width:20%; text-align: left;" align="right"> <asp:TextBox ID="txtradiology" runat="server" pattern="[0-9]+([,\.][0-9]+)?"
         MaxLength="2" CssClass="form-control input-sm m-bot15" value="0.00" 
            onclick="if(this.value=='0.00'){this.value=''}" onblur="if(this.value==''){this.value='0.00'}"></asp:TextBox>
         </td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
    
