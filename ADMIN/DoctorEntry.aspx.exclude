      <div id="div3" runat="server" style="border: thin solid #000000;">

     <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label2" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Doctor Name:</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtdoctornm" runat="server" pattern="^[A-Za-z -]+$"></asp:TextBox>
         </td>
    <td style="width:20%" align="right"><asp:Label ID="Label1" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Doctor Type :</td>
    <td style="width:20%" align="left">
        <asp:DropDownList ID="dropdtType" runat="server" >
            <asp:ListItem>Please Select</asp:ListItem>
            <asp:ListItem>Radiologist</asp:ListItem>
            <asp:ListItem>Cardiologists</asp:ListItem>
             <asp:ListItem>Anesthesiologists</asp:ListItem>
            <asp:ListItem>Urologists</asp:ListItem>
             <asp:ListItem>Gastroenterologists</asp:ListItem>
            <asp:ListItem>Dermatologists</asp:ListItem>
             <asp:ListItem>Endocrinologists</asp:ListItem>
            <asp:ListItem>Neurologists</asp:ListItem>
        </asp:DropDownList>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
     <table width="100%">
     <tr>
    <td style="width:20%" align="right"><%--<asp:Label ID="Label3" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>--%>Link To Doctor :</td>
    <td style="width:20%" align="left">
         <asp:DropDownList ID="dropLinkDoct" runat="server" >
           
        </asp:DropDownList>

      
         </td>
    <td style="width:20%" align="right"><asp:Label ID="Label3" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Present Address :</td>
    <td style="width:20%" align="left">
         <asp:TextBox ID="txtadressps" runat="server" TextMode="MultiLine"></asp:TextBox>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table> 
     <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label5" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>District :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtdistrict" runat="server" pattern="^[A-Za-z -]+$"></asp:TextBox>
         </td>
    <td style="width:20%" align="right"></td>
    <td style="width:20%" align="left">
          <asp:CheckBox ID="CheckBox1" runat="server" Text="Present address as above" AutoPostBack="True"  OnCheckedChanged="CheckBox1_CheckedChanged" />
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
     <table width="100%">
     <tr>
    <td style="width:20%" align="right"> <asp:Label ID="Label6" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>State:</td>
    <td style="width:20%" align="left">
          <asp:TextBox ID="txtstate" runat="server" pattern="^[A-Za-z -]+$"></asp:TextBox>       
         </td>
    <td style="width:20%" align="right"><asp:Label ID="Label9" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Permanent Address :</td>
    <td style="width:20%" align="left">
           <asp:TextBox ID="txtadresspm" runat="server" TextMode="MultiLine"></asp:TextBox>
       
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
     <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label7" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Pin Code :</td>
    <td style="width:20%" align="left">
       <asp:TextBox ID="txtpincode" runat="server" pattern="[0-9]+"></asp:TextBox>
         </td>
    <td style="width:20%" align="right">Area :</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtArea" runat="server" TextMode="MultiLine"></asp:TextBox>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
     <table width="100%">
     <tr>
    <td style="width:20%" align="right"><asp:Label ID="Label8" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Mobile No:</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtmobilno" runat="server" onkeypress="return onlyNos(event);" MaxLength="10" MinLength="10"></asp:TextBox>
         </td>
    <td style="width:20%" align="right">Email Id </td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtemailid" runat="server" type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,3}$"></asp:TextBox>
         </td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
           <div id="div1" runat="server" style="border: thin solid #000000;width:auto;">
       <table width="100%">
     <tr>
