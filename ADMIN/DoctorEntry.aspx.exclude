    <td style="width:20%" align="right"><asp:Label ID="Label12" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Fees:</td>
    <td style="width:20%" align="left"><asp:TextBox ID="txtfees" runat="server" onkeypress="return onlyNos(event);" MaxLength="4" ></asp:TextBox></td>
    <td style="width:20%" align="center"></td>
</tr>
</table>
             <table width="100%">
     <tr>
    <td style="width:20%" align="right">Signature Upload :</td>
    <td style="width:20%" align="left">
        <asp:FileUpload ID="fluImgg" runat="server" />
         </td>
    <td style="width:20%" align="right">Active</td>
    <td style="width:20%" align="left">
        <asp:CheckBox ID="chkactive" runat="server" />
         </td>
    <td style="width:20%" align="center"></td>
</tr>
