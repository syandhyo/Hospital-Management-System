        <asp:TextBox ID="txtspecArea" runat="server" ></asp:TextBox>
         </td>
    <td style="width:20%" align="right"><asp:Label ID="Label13" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Follow Up Days Limit:</td>
    <td style="width:20%" align="left">
        <asp:TextBox ID="txtfoloupdy" runat="server"></asp:TextBox>
       
         </td>
