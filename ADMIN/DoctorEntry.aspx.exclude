         </td>
    <td style="width:20%" align="right"><asp:Label ID="Label10" runat="server" Text="*" ForeColor="#CC0000"></asp:Label>Category :</td>
    <td style="width:20%" align="left">
       <asp:TextBox ID="txtCategory" runat="server" ></asp:TextBox>
         </td>
