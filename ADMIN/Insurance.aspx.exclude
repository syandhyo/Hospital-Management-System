        Phone :</td>
    <td style="width:20%; text-align: left;" align="right"> <asp:TextBox ID="txtphone" runat="server"  pattern="[0-9]+([,\.][0-9]+)?" MaxLength="11" CssClass="form-control input-sm m-bot15"></asp:TextBox>
         </td>
    <td style="width:20%" align="left"></td>
