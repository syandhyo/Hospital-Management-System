         <div id="div3" runat="server" style="border: thin solid #000000;">
    <table width="100%">
     <tr>
    <td style="width:20%" align="right"></td>
    <td style="width:20%; text-align: right;" align="left">
        <asp:Label ID="Label2" runat="server" ForeColor="Red" Text="*"></asp:Label>Name :</td>
    <td style="width:20%; text-align: left;" align="right">
        <asp:TextBox ID="txtname" runat="server" CssClass="form-control input-sm m-bot15"  pattern="^[A-Za-z. -]+$"></asp:TextBox>
         </td>
    <td style="width:20%" align="left"></td>
    <td style="width:20%" align="center"></td>
</tr>
