    protected void grvdoctor_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            var slno = grvdoctor.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlCommand com = new SqlCommand("select * from TBL_DOCTORENTY where ID='" + slno + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                btncreate.Visible = false;
                btnupdate.Visible = true;
                txtid.Text = slno.ToString();

                txtdoctornm.Text = dr["DOCTORNAME"].ToString();
                dropdtType.Text = dr["DOCTORTYPE"].ToString();
                dropLinkDoct.SelectedItem.Text = dr["LINKTODOCTOR"].ToString();
                txtadressps.Text = dr["ADRESSS"].ToString();
                txtadresspm.Text = dr["RESDADRESS"].ToString();
                txtArea.Text = dr["AREA"].ToString();
                txtdistrict.Text = dr["DISTRICT"].ToString();
                txtstate.Text = dr["STATE"].ToString();
                txtpincode.Text = dr["PINCODE"].ToString();
                txtmobilno.Text = dr["MOBILNO"].ToString();
                txtemailid.Text = dr["EMAILID"].ToString();
                txtqualifc.Text = dr["QUALIFCN"].ToString();
                txtCategory.Text = dr["CATEGORY"].ToString();
                txtspecArea.Text = dr["SPLAREA"].ToString();
                txtfees.Text = dr["FEES"].ToString();
                txtfoloupdy.Text = dr["Follow_up_limit"].ToString();
                string chkactv = dr["ACTIVE"].ToString();
                if (chkactv == "True")
                {
                    chkactive.Checked = true;
                }
                else
                {
                    chkactive.Checked = false;
                }

            }
            dr.Close();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
