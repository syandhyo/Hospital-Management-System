using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Data.SqlClient;
using System.Configuration;
using System.Data;

public partial class ADMIN_Corporoomchrg : System.Web.UI.Page
{
    string num1 = "SJ000";
    SqlConnection con;
    SqlCommand com, cmd;
    SqlDataReader dr;
    SqlDataAdapter da,da1;
    DataTable dt;
    decimal total_amt = 0;
    decimal total_vat_amt = 0;
    int i, no, no1, sl;
    GridViewRow gr;

    protected void Page_Load(object sender, EventArgs e)
    {
        try
        {
            if (Session["out"] == "INACTIVE")
            {
                Response.Redirect("~/index.aspx");
            }
            Response.Buffer = true;

            Response.CacheControl = "no-cache";
            if (Session["NAME"] == null)
            {
                Response.Redirect("~/index.aspx");
            }

            lblid.Text = Session["NAME"].ToString();
            lblorgid.Text = Session["ORGID"].ToString();
            if (!IsPostBack)
            {
                binddata();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    public void binddata()
    {
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
       // SqlDataAdapter Adp = new SqlDataAdapter("select A.ID,B.CNAME,A.WARDID,C.NAME as WNAME,A.PRICE from  TBL_CORPROOMRATE A,Corporate_Table B,WARD_TABLE C WHERE A.ID=C.ID AND A.ID= B.ID ORDER BY A.ID DESC", con);
       // SqlDataAdapter Adp = new SqlDataAdapter("select * from TBL_CORPROOMRATE ORDER BY ID DESC", con);
        using (SqlCommand cmd1 = new SqlCommand("ADMIN_Corporate_RentRoom_SELECT", con))
        {
            cmd1.CommandType = CommandType.StoredProcedure;
            cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT";
            DataTable dt = new DataTable();
            SqlDataAdapter Adp = new SqlDataAdapter(cmd1);
            DataTable Dt = new DataTable();
            Adp.Fill(Dt);
            grvrooment.DataSource = Dt;
            grvrooment.DataBind();
        }


        //----------------------
        da1 = new SqlDataAdapter("select distinct ID,CNAME from Corporate_Table", con);
        DataTable ds1 = new DataTable();
        da1.Fill(ds1);
        dropCorp.DataSource = ds1;
        dropCorp.DataTextField = "CNAME";
        dropCorp.DataValueField = "ID";
        dropCorp.DataBind();
        dropCorp.Items.Insert(0, "Please Select");

        //------------------
        da = new SqlDataAdapter("select distinct ID, NAME from WARD_TABLE", con);
        DataTable ds = new DataTable();
        da.Fill(ds);
        dropWard.DataSource = ds;
        dropWard.DataTextField = "NAME";
        dropWard.DataValueField = "ID";
        dropWard.DataBind();
        dropWard.Items.Insert(0, "Please Select");

        try
        {
            using (SqlCommand COM = new SqlCommand("FINANCIAL_YEAR", con))
            {
                COM.CommandType = CommandType.StoredProcedure;
                COM.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
                dr = COM.ExecuteReader();
                if (dr.Read())
                {
                    lblfyear.Text = dr["FYEAR"].ToString();
                }
                dr.Close();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        con.Close();
    }
    protected void grvrooment_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            var slno = grvrooment.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlCommand com = new SqlCommand("select * from TBL_CORPROOMRATE where ID='" + slno + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                btncreate.Visible = false;
                btnupdate.Visible = true;
                txtid.Text = slno.ToString();
                dropCorp.Text = dr["CORPORATEID"].ToString();
                dropWard.Text = dr["WARDID"].ToString();
                txtprice.Text = dr["PRICE"].ToString();

            }
            dr.Close();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void grvrooment_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        try
        {
            if (e.Row.RowType == DataControlRowType.DataRow)
            {
                // reference the Delete LinkButton
                LinkButton db = (LinkButton)e.Row.Cells[4].Controls[0];
                db.OnClientClick = "return confirm('Are you sure want to delete this item ?');";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void grvrooment_RowDeleting(object sender, GridViewDeleteEventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();

            string slno = grvrooment.DataKeys[e.RowIndex].Values["ID"].ToString();
            SqlCommand cm = new SqlCommand("delete from TBL_CORPROOMRATE where ID='" + slno + "'", con);
            cm.ExecuteNonQuery();
            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void grvrooment_PageIndexChanging(object sender, GridViewPageEventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
           // SqlDataAdapter Adp = new SqlDataAdapter("select A.ID,B.CNAME,A.WARDID,C.NAME as WNAME,A.PRICE from  TBL_CORPROOMRATE A,Corporate_Table B,WARD_TABLE C WHERE A.ID=C.ID AND A.ID= B.ID ORDER BY A.ID DESC", con);

            using (SqlCommand cmd1 = new SqlCommand("ADMIN_Corporate_RentRoom_SELECT", con))
            {
                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECT";
                DataTable dt = new DataTable();
                SqlDataAdapter Adp = new SqlDataAdapter(cmd1);
                Adp.Fill(dt);
                grvrooment.DataSource = dt;
                grvrooment.PageIndex = e.NewPageIndex;
                grvrooment.DataKeyNames = new string[] { "ID" };
                grvrooment.DataBind();
            }
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void btncreate_Click(object sender, EventArgs e)
    {
        try
        {
            if (dropCorp.SelectedIndex == 0)
            {
                string message = "alert('* Corporate Name is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            else if (dropWard.SelectedIndex == 0)
            {
                string message = "alert('* Ward is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            if (txtprice.Text == "")
            {
                string message = "alert('* Price is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
           // SqlCommand cmd1 = new SqlCommand("insert into TBL_CORPROOMRATE (CORPORATEID,WARDID,PRICE,FYEAR) values (@CORPORATEID,@WARDID,@PRICE,@FYEAR)", con);

            using (SqlCommand cmd1 = new SqlCommand("ADMIN_Corporate_RentRoom", con))
            {
                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "INSERT";
                cmd1.Parameters.Add("@ID", SqlDbType.Int).Value = 1;
                cmd1.Parameters.Add("@CORPORATEID", SqlDbType.VarChar).Value = dropCorp.SelectedValue;
                cmd1.Parameters.Add("@WARDID", SqlDbType.VarChar).Value = dropWard.SelectedValue;
                cmd1.Parameters.Add("@PRICE", SqlDbType.Decimal).Value = txtprice.Text;
                cmd1.Parameters.Add("@FYEAR", SqlDbType.VarChar).Value = lblfyear.Text;
                cmd1.ExecuteNonQuery();
            }
            string message1 = "alert('Created Successfully.')";
            ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message1, true);
            resetCt();
            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/ADMIN/Corporoomchrg.aspx");
    }
    public void resetCt()
    {
        txtprice.Text = "";
        dropWard.SelectedIndex = 0;
    }
    protected void btnupdate_Click(object sender, EventArgs e)
    {
        try
        {
            if (dropCorp.SelectedIndex == 0)
            {
                string message = "alert('* Corporate Name is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            else if (dropWard.SelectedIndex == 0)
            {
                string message = "alert('* Ward is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            if (txtprice.Text == "")
            {
                string message = "alert('* Price is mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
           // SqlCommand cmd1 = new SqlCommand("update TBL_CORPROOMRATE set CORPORATEID=@CORPORATEID,WARDID=@WARDID,PRICE=@PRICE where ID=@ID", con);
            using (SqlCommand cmd1 = new SqlCommand("ADMIN_Corporate_RentRoom", con))
            {
                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "UPDATE";
                cmd1.Parameters.Add("@ID", SqlDbType.Int).Value = txtid.Text;
                cmd1.Parameters.Add("@CORPORATEID", SqlDbType.VarChar).Value = Convert.ToInt32(dropCorp.SelectedValue);
                cmd1.Parameters.Add("@WARDID", SqlDbType.VarChar).Value = dropWard.SelectedValue;
                cmd1.Parameters.Add("@PRICE", SqlDbType.VarChar).Value = txtprice.Text;
                cmd1.Parameters.Add("@FYEAR", SqlDbType.VarChar).Value = lblfyear.Text;
                cmd1.ExecuteNonQuery();
            }
            string message1 = "alert('Updated Successfully.')";
            ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message1, true);
            resetCt();
            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/ADMIN/Corporoomchrg.aspx");
    }
    protected void btncancel_Click(object sender, EventArgs e)
    {
        Response.Redirect("~/ADMIN/Corporoomchrg.aspx");
    }
}