    protected void GridView1_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            var slno = GridView1.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlCommand com = new SqlCommand("select * from LOGIN_TABLE where ID='" + slno + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                btncreate.Visible = false;
                btnupdate.Visible = true;
                lblusid.Text = dr["ID"].ToString();
                Dropempname.Text = dr["NAME"].ToString();
                txtusername.Text = dr["USERNAME"].ToString();
                txtpassword.Text = dr["PASSWORD"].ToString();
                txtcnfrmpassword.Text = dr["PASSWORD"].ToString();
                dropstatus.Text = dr["STATUS"].ToString();
            }
            dr.Close();
            using (SqlCommand cmd = new SqlCommand())
            {
                cmd.CommandText = "select * from USER_PERMISSION_TABLE where ID='" + lblusid.Text + "'";
                cmd.Connection = con;

                using (SqlDataReader sdr = cmd.ExecuteReader())
                {
                    CheckBoxList1.Items.Clear();
                    while (sdr.Read())
                    {
                        ListItem item = new ListItem();
                        item.Text = sdr["PER"].ToString();
                        item.Value = sdr["PER"].ToString();
                        item.Selected = Convert.ToBoolean(sdr["selected"]);

                        CheckBoxList1.Items.Add(item);
                    }
                }

            }
            using (SqlCommand cmd = new SqlCommand())
            {
                cmd.CommandText = "select * from USER_MODULE_TABLE where ID='" + lblusid.Text + "'";
                cmd.Connection = con;

                using (SqlDataReader sdr = cmd.ExecuteReader())
                {
                    CheckBoxList2.Items.Clear();
                    while (sdr.Read())
                    {
                        ListItem item = new ListItem();
                        item.Text = sdr["MODULE"].ToString();
                        item.Value = sdr["MODULE"].ToString();
                        item.Selected = Convert.ToBoolean(sdr["selected"]);

                        CheckBoxList2.Items.Add(item);
                    }
                }

            }
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void gvDetails_RowDeleting(object sender, GridViewDeleteEventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();

            string slno = GridView1.DataKeys[e.RowIndex].Values["ID"].ToString();
            SqlCommand cm = new SqlCommand("delete from LOGIN_TABLE where ID='" + slno + "'", con);
            cm.ExecuteNonQuery();
            SqlCommand cm1 = new SqlCommand("delete from USER_PERMISSION_TABLE where ID='" + slno + "'", con);
            cm1.ExecuteNonQuery();
            SqlDataAdapter da1 = new SqlDataAdapter("delete from USER_MODULE_TABLE WHERE ID='" + slno + "'", con);
            DataSet ds1 = new DataSet();
            da1.Fill(ds1, "USER_MODULE_TABLE");
            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/ADMIN/usercreation.aspx");
    }
    protected void GridView1_PageIndexChanging(object sender, GridViewPageEventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            SqlDataAdapter da = new SqlDataAdapter("SELECT ID as ID,NAME,STATUS FROM LOGIN_TABLE WHERE  ORGID='" + lblorgid.Text + "' ORDER BY ID DESC", con);
            DataTable dt = new DataTable();
            da.Fill(dt);
            GridView1.SelectedIndex = 0;
            GridView1.DataSource = dt;
            GridView1.PageIndex = e.NewPageIndex;
            GridView1.DataKeyNames = new string[] { "ID" };
            GridView1.DataBind();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
