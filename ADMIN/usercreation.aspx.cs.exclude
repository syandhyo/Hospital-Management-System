public partial class ADMIN_usercreation : System.Web.UI.Page
{
    string num1 = "SJ000";
    SqlConnection con;
    SqlCommand com, cmd;
    SqlDataReader dr;
    SqlDataAdapter da;
    DataTable dt;
    decimal total_amt = 0;
    decimal total_vat_amt = 0;
    int i, no, no1, sl;
    GridViewRow gr;
    public void auto()
    {
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        string qry1 = "select ID from LOGIN_TABLE";

        com = new SqlCommand(qry1, con);
        dr = null;

        dr = com.ExecuteReader();

        while (dr.Read())
        {
            num1 = dr["ID"].ToString();
        }
        num1 = string.Format("US{0}", (Convert.ToUInt32(num1.Substring(2)) + 1).ToString("D4"));
        lblusid.Text = num1;

        dr.Close();
        con.Close();
    }
    protected void Page_Load(object sender, EventArgs e)
    {
        if (Session["out"] == "INACTIVE")
        {
            Response.Redirect("~/index.aspx");
        }
        Response.Buffer = true;

        Response.CacheControl = "no-cache";
        if (Session["NAME"] == null)
        {
            Response.Redirect("~/index.aspx");
        }
        //lbldate.Text = DateTime.Now.ToString("dd-MM-yyyy");
        lblid.Text = Session["NAME"].ToString();
        lblorgid.Text = Session["ORGID"].ToString();
        if (!IsPostBack)
        {
            binddata();
        }
        //clear_control();
    }
    public void binddata()
    {
        SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
        con.Open();
        SqlDataAdapter da = new SqlDataAdapter("SELECT ID as ID,NAME,STATUS FROM LOGIN_TABLE WHERE  ORGID='" + lblorgid.Text + "' ORDER BY ID DESC", con);
        DataTable dt = new DataTable();
        da.Fill(dt);
        GridView1.SelectedIndex = 0;
        GridView1.DataSource = dt;
        GridView1.DataKeyNames = new string[] { "ID" };
        GridView1.DataBind();


        try
        {
            using (SqlCommand COM = new SqlCommand("FINANCIAL_YEAR", con))
            {
                COM.CommandType = CommandType.StoredProcedure;
                COM.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
                dr = COM.ExecuteReader();
                if (dr.Read())
                {
                    lblfyear.Text = dr["FYEAR"].ToString();
                }
                dr.Close();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);

        }
        SqlDataAdapter da1 = new SqlDataAdapter("select distinct sname+' '+EMPID AS SNAME ,EMPID FROM tblstaff where ORGID='" + lblorgid.Text + "'", con);
        DataTable ds1 = new DataTable();
        da1.Fill(ds1);
        Dropempname.DataSource = ds1;
        Dropempname.DataTextField = "SNAME";
        Dropempname.DataValueField = "SNAME";
        Dropempname.DataBind();
        con.Close();
    }
    protected void GridView1_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        if (e.Row.RowType == DataControlRowType.DataRow)
        {
            // reference the Delete LinkButton
            LinkButton db = (LinkButton)e.Row.Cells[2].Controls[0];

            db.OnClientClick = "return confirm('Are you sure want to delete this User ?');";
        }
    }

    protected void Button1_Click(object sender, EventArgs e)
    {
        try
        {
            if (txtusername.Text == "")
            {
                string message = "alert('* Fields are mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            else if (txtpassword.Text == "")
            {
                string message = "alert('* Fields are mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }


            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();

            SqlCommand com = new SqlCommand("select * from LOGIN_TABLE where USERNAME='" + txtusername.Text.ToUpper() + "' and ORGID='" + lblorgid.Text + "'", con);
            dr = com.ExecuteReader();
            if (dr.Read())
            {
                string message = "alert('* USERNAME Alredy Exist.Try New Username.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            dr.Close();
            SqlCommand com1 = new SqlCommand("select * from LOGIN_TABLE where NAME='" + Dropempname.Text + "' and ORGID='" + lblorgid.Text + "'", con);
            dr = com1.ExecuteReader();
            if (dr.Read())
            {
                string message = "alert('* Employee Alredy Exist.Try New Username.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            dr.Close();

            auto();

            //SqlCommand cmd1 = new SqlCommand("insert into LOGIN_TABLE (ID,ORGID,NAME,USERNAME,PASSWORD,STATUS) values (@ID,@ORGID,@NAME,@USERNAME,@PASSWORD,@STATUS)", con);
            using (SqlCommand cmd1 = new SqlCommand("ADMIN_USER_CREATION", con))
            {

                cmd1.CommandType = CommandType.StoredProcedure;
                cmd1.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "INSERT";
                cmd1.Parameters.Add("@ID", SqlDbType.VarChar).Value = lblusid.Text;
                cmd1.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
                cmd1.Parameters.Add("@NAME", SqlDbType.VarChar).Value = Dropempname.SelectedItem.ToString();
                cmd1.Parameters.Add("@USERNAME", SqlDbType.VarChar).Value = txtusername.Text.ToUpper();
                cmd1.Parameters.Add("@PASSWORD", SqlDbType.VarChar).Value = txtpassword.Text;
                cmd1.Parameters.Add("@STATUS", SqlDbType.VarChar).Value = dropstatus.Text;
                cmd1.ExecuteNonQuery();
            }

            using (SqlCommand cmd = new SqlCommand())
            {
                cmd.CommandText = "insert into USER_PERMISSION_TABLE (ID,ORGID,PER,selected)values(@ID,@ORGID,@PER,@selected)";
                cmd.Connection = con;
                foreach (ListItem item in CheckBoxList1.Items)
                {
                    cmd.Parameters.Clear();
                    cmd.Parameters.AddWithValue("@ID", lblusid.Text);
                    cmd.Parameters.AddWithValue("@ORGID", lblorgid.Text);
                    cmd.Parameters.AddWithValue("@PER", item.Text);
                    cmd.Parameters.AddWithValue("@selected", item.Selected);
                    cmd.ExecuteNonQuery();
                }
            }
            using (SqlCommand cmd = new SqlCommand())
            {
                cmd.CommandText = "insert into USER_MODULE_TABLE (ID,MODULE,selected)values(@ID,@MODULE,@selected) ";
                cmd.Connection = con;
                foreach (ListItem item in CheckBoxList2.Items)
                {
                    cmd.Parameters.Clear();
                    cmd.Parameters.AddWithValue("@ID", lblusid.Text);
                    cmd.Parameters.AddWithValue("@MODULE", item.Text);
                    cmd.Parameters.AddWithValue("@selected", item.Selected);
                    cmd.ExecuteNonQuery();
                }
            }

            binddata();
            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
        Response.Redirect("~/ADMIN/usercreation.aspx");
    }
    protected void Button2_Click(object sender, EventArgs e)
    {
        try
        {
            if (txtusername.Text == "")
            {
                string message = "alert('* Fields are mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }
            else if (txtpassword.Text == "")
            {
                string message = "alert('* Fields are mandatory.')";
                ScriptManager.RegisterClientScriptBlock((sender as Control), this.GetType(), "alert", message, true);
                return;
            }


            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
