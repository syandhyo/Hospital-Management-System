    protected void GridView2_SelectedIndexChanging(object sender, GridViewSelectEventArgs e)
    {
        try
        {
            SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
          
            var slno = GridView2.DataKeys[e.NewSelectedIndex].Values["ID"].ToString();
            SqlCommand C2m = new SqlCommand("select * from CORPORATE_DOCTOR_CHARGE where ID='" + slno + "'", con);
            dr = C2m.ExecuteReader();
            if (dr.Read() == true)
            {
                ddlcorporate.SelectedItem.Text = dr["CORPORATE"].ToString();
                Txtdate.Text = Convert.ToDateTime(dr["APPLY_DATE"]).ToString("dd-MM-yyyy");
            }
            dr.Close();
            // 
             using (SqlCommand cmd2 = new SqlCommand("ADMIN_corpo_charge_doctor_select", con))
            {
                cmd2.CommandType = CommandType.StoredProcedure;
                cmd2.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "INSERT";
                cmd2.Parameters.Add("@CID", SqlDbType.VarChar).Value = slno;
                cmd2.Parameters.Add("@DATE", SqlDbType.DateTime).Value = Convert.ToDateTime(Txtdate.Text).ToString("yyyy-MM-dd");
                SqlDataAdapter da = new SqlDataAdapter(cmd2);
                //SqlDataAdapter da = new SqlDataAdapter("select * from Doctor_charges where CID='" + slno + "' and APPLY_DATE='" + Txtdate.Text + "'", con);
                DataSet ds = new DataSet();
                da.Fill(ds);
                btnSubmit.Visible = false;
                btndelete.Visible = true;
                btnupdate.Visible = true;
                txtid.Text = ds.Tables[0].Rows[0]["CID"].ToString();
                GridView3.DataSource = ds;
                GridView3.DataBind();
                GridView1.Visible = false;


                //SqlCommand Cm = new SqlCommand("select * from CORPORATE_DOCTOR_CHARGE where ID='" + slno + "'", con);
                //dr = Cm.ExecuteReader();
                //if (dr.Read() == true)
                //{
                //    ddlcorporate.SelectedItem.Text = dr["CORPORATE"].ToString();
                //    Txtdate.Text = dr["APPLY_DATE"].ToString();
                //}
                //dr.Close();


                SqlDataAdapter da1 = new SqlDataAdapter("select * from Corporate_Table where ISACTIVE='true' and CNAME='" + ddlcorporate.SelectedItem.Text + "'", con);
                DataTable ds1 = new DataTable();
                da1.Fill(ds1);
                ddlcorporate.DataSource = ds1;
                ddlcorporate.DataTextField = "CNAME";
                ddlcorporate.DataValueField = "ID";
                ddlcorporate.DataBind();
              
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
    protected void GridView2_PageIndexChanging(object sender, GridViewPageEventArgs e)
    {
        try
        {
            //SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
            con.Open();
            using (SqlCommand cmd = new SqlCommand("ADMIN_corpo_charge_doctor", con))
            {
                cmd.CommandType = CommandType.StoredProcedure;
                cmd.Parameters.Add("@DBOpration", SqlDbType.VarChar).Value = "SELECTALL";
                cmd.Parameters.Add("@ID", SqlDbType.VarChar).Value = "id";
                cmd.Parameters.Add("@ORGID", SqlDbType.VarChar).Value = lblorgid.Text;
                cmd.Parameters.Add("@idt", SqlDbType.VarChar).Value = "id";
                cmd.Parameters.Add("@DOCTOR", SqlDbType.VarChar).Value = "id";
                cmd.Parameters.Add("@FOLLOW_UP", SqlDbType.VarChar).Value = "id";
                cmd.Parameters.Add("@CHARGES", SqlDbType.VarChar).Value = "0.00";
                cmd.Parameters.Add("@CID", SqlDbType.VarChar).Value = txtid.Text;
                cmd.Parameters.Add("@CORPORATE_ID", SqlDbType.VarChar).Value = ddlcorporate.SelectedValue;
                cmd.Parameters.Add("@CORPORATE", SqlDbType.VarChar).Value = ddlcorporate.SelectedValue;
                cmd.Parameters.Add("@APPLY_DATE", SqlDbType.DateTime).Value = Convert.ToDateTime(Txtdate.Text).ToString("yyyy-MM-dd");
                cmd.Parameters.Add("@DATE", SqlDbType.DateTime).Value = DateTime.Now.ToString("yyyy-MM-dd");
                cmd.ExecuteNonQuery();
                SqlDataAdapter Adp = new SqlDataAdapter(cmd);
                DataTable Dt = new DataTable();
                Adp.Fill(Dt);
                GridView2.DataSource = Dt;
                GridView2.PageIndex = e.NewPageIndex;
                GridView2.DataKeyNames = new string[] { "ID" };
                GridView2.DataBind();
            }

            con.Close();
        }
        catch (Exception ex)
        {
            Console.WriteLine("An error occurred: '{0}'", ex);
        }
    }
