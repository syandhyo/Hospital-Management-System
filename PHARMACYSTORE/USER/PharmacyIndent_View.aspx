    <script type="text/javascript" >
        function PrintDivlastDayInfo() {
            var divToPrint = document.getElementById('div1');
            var popupWin = window.open('', '_blank', 'width=1000,height=1000');
            popupWin.document.open();
            popupWin.document.write('<html><body onload="window.print()">');
            //popupWin.document.write('<img alt="" height="100" src="../images/FINAL.jpg" width="500" />');
            popupWin.document.write('<hr>');
            popupWin.document.write('<p style="font-family: Aharoni">');
            popupWin.document.write(divToPrint.innerHTML);
            popupWin.document.write('</p>');
            popupWin.document.write('</body>');
            popupWin.document.write('</HTML>');
            popupWin.document.close();

        }
</script>
