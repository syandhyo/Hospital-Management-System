public partial class RADIOLOGY_Radiology_rate_insurance : System.Web.UI.Page
{
    string num1 = "000";
    SqlConnection con = new SqlConnection(ConfigurationManager.ConnectionStrings["abcd"].ToString());
    SqlCommand com, cmd, cmd1;
